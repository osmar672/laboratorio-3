    categoria_arancelaria ||--o{ producto : clasifica
    declaracion_aduanera ||--|{ detalle_declaracion : contiene
    producto ||--o{ detalle_declaracion : aparece_en
    transportista ||--o{ contenedor : transporta
    declaracion_aduanera ||--o{ contenedor : ampara
    bodega ||--o{ inventario_bodega : ubica
    producto ||--o{ inventario_bodega : existencias
    declaracion_aduanera ||--o{ inventario_bodega : trazabilidad
