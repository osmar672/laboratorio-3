digraph inventario_aduanero_erd {
	bgcolor="#f6f8fb" fontcolor="#15263d" fontname="DejaVu Sans" fontsize=21 label="Sistema de Inventario Aduanero — Diagrama entidad-relación (16 tablas)
Extremos: 1 y 0..N; funcionario puede tener supervisor opcional (0..1) y 0..N subordinados" labelloc=t nodesep=0.42 overlap=false pad=0.28 rankdir=LR ranksep=0.75 splines=polyline
	node [fontname="DejaVu Sans" fontsize=10 shape=plain]
	edge [arrowsize=0.7 color="#7186a3" fontcolor="#263849" fontname="DejaVu Sans" fontsize=9 penwidth=1.1]
	pais [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#9aabc0"><TR><TD BGCOLOR="#193654" ALIGN="LEFT"><FONT COLOR="white"><B>pais</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">PK id_pais INT</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">nombre VARCHAR(100)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">codigo_iso CHAR(2) UNIQUE</TD></TR></TABLE>>]
	importador [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#9aabc0"><TR><TD BGCOLOR="#193654" ALIGN="LEFT"><FONT COLOR="white"><B>importador</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">PK id_importador INT</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">razon_social VARCHAR(160)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">identificacion_fiscal VARCHAR(30) UNIQUE</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">direccion VARCHAR(220)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">telefono VARCHAR(30)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">correo VARCHAR(160) UNIQUE</TD></TR></TABLE>>]
	exportador [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#9aabc0"><TR><TD BGCOLOR="#193654" ALIGN="LEFT"><FONT COLOR="white"><B>exportador</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">PK id_exportador INT</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">razon_social VARCHAR(160)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">identificacion_fiscal VARCHAR(30) UNIQUE</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">direccion VARCHAR(220)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">telefono VARCHAR(30)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">correo VARCHAR(160) UNIQUE</TD></TR></TABLE>>]
	agente_aduanal [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#9aabc0"><TR><TD BGCOLOR="#193654" ALIGN="LEFT"><FONT COLOR="white"><B>agente_aduanal</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">PK id_agente INT</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">nombre VARCHAR(140)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">numero_licencia VARCHAR(40) UNIQUE</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">telefono VARCHAR(30)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">correo VARCHAR(160) UNIQUE</TD></TR></TABLE>>]
	categoria_arancelaria [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#9aabc0"><TR><TD BGCOLOR="#193654" ALIGN="LEFT"><FONT COLOR="white"><B>categoria_arancelaria</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">PK id_categoria INT</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">codigo_sa CHAR(6) UNIQUE</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">descripcion VARCHAR(220)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">porcentaje_arancel DECIMAL(5,2)</TD></TR></TABLE>>]
	funcionario [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#9aabc0"><TR><TD BGCOLOR="#193654" ALIGN="LEFT"><FONT COLOR="white"><B>funcionario</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">PK id_funcionario INT</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">nombre VARCHAR(140)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">cargo VARCHAR(100)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">FK id_supervisor INT NULL</TD></TR></TABLE>>]
	transportista [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#9aabc0"><TR><TD BGCOLOR="#193654" ALIGN="LEFT"><FONT COLOR="white"><B>transportista</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">PK id_transportista INT</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">razon_social VARCHAR(160)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">codigo_registro VARCHAR(40) UNIQUE</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">telefono VARCHAR(30)</TD></TR></TABLE>>]
	bodega [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#9aabc0"><TR><TD BGCOLOR="#193654" ALIGN="LEFT"><FONT COLOR="white"><B>bodega</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">PK id_bodega INT</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">nombre VARCHAR(120) UNIQUE</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">ubicacion VARCHAR(180)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">capacidad_kg DECIMAL(12,2)</TD></TR></TABLE>>]
	producto [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#9aabc0"><TR><TD BGCOLOR="#193654" ALIGN="LEFT"><FONT COLOR="white"><B>producto</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">PK id_producto INT</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">descripcion VARCHAR(220)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">unidad_medida VARCHAR(30)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">valor_unitario DECIMAL(12,2)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">peso_unitario_kg DECIMAL(10,3)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">FK id_categoria INT</TD></TR></TABLE>>]
	declaracion_aduanera [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#9aabc0"><TR><TD BGCOLOR="#193654" ALIGN="LEFT"><FONT COLOR="white"><B>declaracion_aduanera</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">PK id_declaracion INT</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">numero_declaracion VARCHAR(30) UNIQUE</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">fecha DATE</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">regimen VARCHAR(20)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">estado VARCHAR(20)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">FK id_importador INT NULL</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">FK id_exportador INT NULL</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">FK id_agente INT</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">FK id_pais_origen INT</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">FK id_pais_destino INT NULL</TD></TR></TABLE>>]
	detalle_declaracion [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#9aabc0"><TR><TD BGCOLOR="#193654" ALIGN="LEFT"><FONT COLOR="white"><B>detalle_declaracion</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">PK id_detalle INT</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">FK id_declaracion INT</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">FK id_producto INT</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">cantidad INT</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">valor_unitario_declarado DECIMAL(12,2)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">UNIQUE (id_declaracion,id_producto)</TD></TR></TABLE>>]
	contenedor [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#9aabc0"><TR><TD BGCOLOR="#193654" ALIGN="LEFT"><FONT COLOR="white"><B>contenedor</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">PK id_contenedor INT</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">numero_contenedor VARCHAR(20) UNIQUE</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">tipo VARCHAR(40)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">peso_kg DECIMAL(12,2)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">FK id_transportista INT</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">FK id_declaracion INT</TD></TR></TABLE>>]
	inventario_bodega [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#9aabc0"><TR><TD BGCOLOR="#193654" ALIGN="LEFT"><FONT COLOR="white"><B>inventario_bodega</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">PK id_inventario INT</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">FK id_bodega INT</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">FK id_producto INT</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">FK id_declaracion INT</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">cantidad INT</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">fecha_ingreso DATE</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">estado VARCHAR(12)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">UNIQUE (declaracion,producto,bodega)</TD></TR></TABLE>>]
	movimiento_inventario [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#9aabc0"><TR><TD BGCOLOR="#193654" ALIGN="LEFT"><FONT COLOR="white"><B>movimiento_inventario</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">PK id_movimiento INT</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">tipo_movimiento VARCHAR(12)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">fecha DATETIME</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">cantidad INT</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">FK id_producto INT</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">FK id_declaracion INT</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">FK id_bodega_origen INT NULL</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">FK id_bodega_destino INT NULL</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">FK id_funcionario INT</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">referencia VARCHAR(40) UNIQUE</TD></TR></TABLE>>]
	inspeccion [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#9aabc0"><TR><TD BGCOLOR="#193654" ALIGN="LEFT"><FONT COLOR="white"><B>inspeccion</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">PK id_inspeccion INT</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">fecha DATETIME</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">resultado VARCHAR(30)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">observaciones VARCHAR(500)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">FK id_declaracion INT</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">FK id_funcionario INT</TD></TR></TABLE>>]
	evento_declaracion [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#9aabc0"><TR><TD BGCOLOR="#193654" ALIGN="LEFT"><FONT COLOR="white"><B>evento_declaracion</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">PK id_evento INT</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">FK id_declaracion INT</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">fecha_hora DATETIME</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">tipo_evento VARCHAR(100)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">descripcion VARCHAR(500)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">FK id_funcionario INT</TD></TR></TABLE>>]
	pais -> declaracion_aduanera [headlabel="0..N" labelangle=24 labeldistance=1.45 taillabel=1]
