	producto -> inventario_bodega [headlabel="0..N" labelangle=24 labeldistance=1.45 taillabel=1]
	declaracion_aduanera -> inventario_bodega [headlabel="0..N" labelangle=24 labeldistance=1.45 taillabel=1]
